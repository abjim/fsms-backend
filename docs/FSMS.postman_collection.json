{
  "info": {
    "name": "Field Service Management System (FSMS)",
    "description": "Comprehensive Postman collection for the FSMS REST API backend with full RBAC authentication, dispatching, and SSLCommerz payment flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Farhan Ahmed\",\n  \"email\": \"customer@fsms.com\",\n  \"password\": \"Customer@123\",\n  \"phone\": \"01722334455\",\n  \"address\": \"Banani, Dhaka\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Technician",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Chowdhury\",\n  \"email\": \"tech@fsms.com\",\n  \"password\": \"Tech@1234\",\n  \"phone\": \"01811223344\",\n  \"address\": \"Mirpur-10, Dhaka\",\n  \"role\": \"TECHNICIAN\",\n  \"city\": \"Dhaka\",\n  \"bio\": \"Senior HVAC specialist\",\n  \"skills\": [\"HVAC\", \"Electrical\"],\n  \"hourlyRate\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fsms.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@fsms.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Technician",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@fsms.com\",\n  \"password\": \"Tech@1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Customer@123\",\n  \"newPassword\": \"Customer@999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01799887766\",\n  \"address\": \"Gulshan-1, Dhaka\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Admin Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10&role=CUSTOMER",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "role", "value": "CUSTOMER" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Admin Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Generator Servicing\",\n  \"description\": \"Diesel and gas generator preventive maintenance\",\n  \"icon\": \"power\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Admin Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated generator servicing description\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Admin Soft Delete Category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["categories", "{{categoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "Technicians",
      "item": [
        {
          "name": "Browse Technicians (Filter & Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/technicians?city=Dhaka&skill=HVAC&isAvailable=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["technicians"],
              "query": [
                { "key": "city", "value": "Dhaka" },
                { "key": "skill", "value": "HVAC" },
                { "key": "isAvailable", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Technician Profile by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/technicians/{{technicianId}}", "host": ["{{baseUrl}}"], "path": ["technicians", "{{technicianId}}"] }
          }
        },
        {
          "name": "Technician Update Weekly Availability",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    { \"dayOfWeek\": 6, \"startTime\": \"09:00\", \"endTime\": \"18:00\" },\n    { \"dayOfWeek\": 0, \"startTime\": \"09:00\", \"endTime\": \"18:00\" },\n    { \"dayOfWeek\": 1, \"startTime\": \"09:00\", \"endTime\": \"18:00\" },\n    { \"dayOfWeek\": 2, \"startTime\": \"09:00\", \"endTime\": \"18:00\" },\n    { \"dayOfWeek\": 3, \"startTime\": \"09:00\", \"endTime\": \"18:00\" },\n    { \"dayOfWeek\": 4, \"startTime\": \"09:00\", \"endTime\": \"18:00\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/technicians/availability", "host": ["{{baseUrl}}"], "path": ["technicians", "availability"] }
          }
        }
      ]
    },
    {
      "name": "Service Requests",
      "item": [
        {
          "name": "Customer Submit Service Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water pump motor vibrating excessively\",\n  \"description\": \"The rooftop suction pump makes loud rattling noise when starting up\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"priority\": \"HIGH\",\n  \"address\": \"House 42, Road 7, Dhanmondi\",\n  \"city\": \"Dhaka\",\n  \"preferredDate\": \"2026-11-26\",\n  \"preferredTime\": \"11:00\",\n  \"contactPhone\": \"01722334455\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/service-requests", "host": ["{{baseUrl}}"], "path": ["service-requests"] }
          }
        },
        {
          "name": "List Service Requests (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/service-requests?status=PENDING&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["service-requests"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Service Request by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/service-requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["service-requests", "{{requestId}}"] }
          }
        },
        {
          "name": "Cancel Service Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/service-requests/{{requestId}}/cancel", "host": ["{{baseUrl}}"], "path": ["service-requests", "{{requestId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Work Orders",
      "item": [
        {
          "name": "Admin Assign Technician (Conflict Check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceRequestId\": \"{{requestId}}\",\n  \"technicianId\": \"{{technicianId}}\",\n  \"scheduledDate\": \"2026-11-26\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"adminNotes\": \"Customer requested arrival before noon\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/work-orders/assign", "host": ["{{baseUrl}}"], "path": ["work-orders", "assign"] }
          }
        },
        {
          "name": "List Work Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/work-orders?status=SCHEDULED&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["work-orders"] }
          }
        },
        {
          "name": "Update Work Order Status (EN_ROUTE / IN_PROGRESS / COMPLETED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"technicianNotes\": \"Arrived at customer premises and started diagnostic check\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/work-orders/{{workOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["work-orders", "{{workOrderId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Service Reports",
      "item": [
        {
          "name": "Technician Submit Service Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderId\": \"{{workOrderId}}\",\n  \"problemFound\": \"Worn motor bearings causing mechanical vibration and thermal overload\",\n  \"workSummary\": \"Dismantled pump assembly, pressed new NSK 6204 bearings, and re-greased\",\n  \"partsUsed\": \"NSK 6204 Bearing (2 units), Seal kit (1 set)\",\n  \"laborHours\": 2.5\n}"
            },
            "url": { "raw": "{{baseUrl}}/service-reports", "host": ["{{baseUrl}}"], "path": ["service-reports"] }
          }
        },
        {
          "name": "Get Report by Work Order ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/service-reports/work-order/{{workOrderId}}", "host": ["{{baseUrl}}"], "path": ["service-reports", "work-order", "{{workOrderId}}"] }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Admin Generate Invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderId\": \"{{workOrderId}}\",\n  \"laborCost\": 1500,\n  \"partsCost\": 850,\n  \"tax\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/invoices/generate", "host": ["{{baseUrl}}"], "path": ["invoices", "generate"] }
          }
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/invoices?status=ISSUED&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Customer Initiate SSLCommerz Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/initiate", "host": ["{{baseUrl}}"], "path": ["payments", "initiate"] }
          }
        },
        {
          "name": "Customer Payment History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/payments/my-history?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["payments", "my-history"] }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Customer Submit Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderId\": \"{{workOrderId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent repair work, technician was very polite and thorough\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reviews", "host": ["{{baseUrl}}"], "path": ["reviews"] }
          }
        },
        {
          "name": "Get Reviews for Technician",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reviews/technician/{{technicianId}}", "host": ["{{baseUrl}}"], "path": ["reviews", "technician", "{{technicianId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard-stats", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard-stats"] }
          }
        },
        {
          "name": "Get System Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "audit-logs"]
            }
          }
        },
        {
          "name": "Admin Update User Status (Suspend/Active)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "status"] }
          }
        }
      ]
    }
  ]
}
