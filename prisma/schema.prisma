generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  ASSIGNED
  CANCELLED
  REJECTED
}

enum WorkOrderStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

enum PaymentProvider {
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  phone     String?
  address   String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  technicianProfile   TechnicianProfile?
  serviceRequests     ServiceRequest[]
  assignedWorkOrders  WorkOrder[]        @relation("AssignedByAdmin")
  invoices            Invoice[]
  payments            Payment[]
  reviews             Review[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model TechnicianProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  skills          String[] @default([])
  experienceYears Int      @default(0)
  hourlyRate      Float    @default(0)
  city            String
  serviceArea     String?
  avgRating       Float    @default(0)
  totalReviews    Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  availabilities TechnicianAvailability[]
  workOrders     WorkOrder[]
  serviceReports ServiceReport[]
  reviews        Review[]

  @@index([city])
  @@index([isAvailable])
  @@map("technician_profiles")
}

model TechnicianAvailability {
  id           String            @id @default(uuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([technicianId, dayOfWeek])
  @@map("technician_availabilities")
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  serviceRequests ServiceRequest[]

  @@index([slug])
  @@map("service_categories")
}

model ServiceRequest {
  id             String               @id @default(uuid())
  customerId     String
  customer       User                 @relation(fields: [customerId], references: [id])
  categoryId     String
  category       ServiceCategory      @relation(fields: [categoryId], references: [id])
  title          String
  description    String
  priority       Priority             @default(MEDIUM)
  status         ServiceRequestStatus @default(PENDING)
  address        String
  city           String
  preferredDate  DateTime
  preferredTime  String
  contactPhone   String
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workOrder WorkOrder?

  @@index([customerId])
  @@index([status])
  @@index([categoryId])
  @@map("service_requests")
}

model WorkOrder {
  id               String          @id @default(uuid())
  serviceRequestId String          @unique
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  technicianId     String
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id])
  assignedById     String
  assignedBy       User            @relation("AssignedByAdmin", fields: [assignedById], references: [id])
  status           WorkOrderStatus @default(SCHEDULED)
  scheduledDate    DateTime
  startTime        String
  endTime          String
  adminNotes       String?
  technicianNotes  String?
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  serviceReport ServiceReport?
  invoice       Invoice?
  review        Review?

  @@index([technicianId])
  @@index([status])
  @@index([scheduledDate])
  @@map("work_orders")
}

model ServiceReport {
  id                   String            @id @default(uuid())
  workOrderId          String            @unique
  workOrder            WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technicianId         String
  technician           TechnicianProfile @relation(fields: [technicianId], references: [id])
  problemFound         String
  workSummary          String
  partsUsed            String?
  laborHours           Float             @default(1.0)
  customerSignatureUrl String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("service_reports")
}

model Invoice {
  id            String        @id @default(uuid())
  workOrderId   String        @unique
  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id])
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  invoiceNumber String        @unique
  laborCost     Float
  partsCost     Float         @default(0)
  tax           Float         @default(0)
  totalAmount   Float
  status        InvoiceStatus @default(ISSUED)
  paidAt        DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id              String          @id @default(uuid())
  invoiceId       String
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  customerId      String
  customer        User            @relation(fields: [customerId], references: [id])
  amount          Float
  currency        String          @default("BDT")
  provider        PaymentProvider @default(SSLCOMMERZ)
  status          PaymentStatus   @default(PENDING)
  transactionId   String          @unique
  gatewayResponse String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([transactionId])
  @@map("payments")
}

model Review {
  id           String            @id @default(uuid())
  workOrderId  String            @unique
  workOrder    WorkOrder         @relation(fields: [workOrderId], references: [id])
  customerId   String
  customer     User              @relation(fields: [customerId], references: [id])
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId])
  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}
